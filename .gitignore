# Echte Nutzerdaten - Datenbank, Backups, hochgeladene Belege. Niemals committen,
# auch nicht in ein privates Repo (Historie ist schwer zu bereinigen).
data/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editor/OS
.vscode/
.DS_Store

# Claude Code lokale Einstellungen (maschinenspezifisch) - Skills/Agents
# darunter sind bewusst KEIN lokaler Kram, sondern Projekt-Wissen, das den
# Klon überleben soll (siehe claude-code-setup-Empfehlung), deshalb per
# Ausnahme wieder eingeschlossen. settings.local.json und *.local.md
# (z.B. hookify-Regeln) bleiben wie der Name sagt lokal/ignoriert.
.claude/*
!.claude/skills/
!.claude/skills/**
!.claude/agents/
!.claude/agents/**

# Secrets, falls mal welche als .env landen
.env
.env.*

# Private Roadmap - interne Prioritäten, nicht für ein öffentliches Repo
ROADMAP.md
